{
  "name": "najdat-al-tariq-24",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "files:cleanup": "tsx --conditions=react-server --env-file=.env scripts/cleanup-orphan-files.ts",
    "test:integration": "node scripts/prepare-test-db.mjs && vitest run -c vitest.integration.config.mts",
    "test:all": "npm test && npm run test:integration",
    "jobs:sweep": "tsx --conditions=react-server --env-file=.env scripts/sweep.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && tsx prisma/seed.ts && next build",
    "email:test": "tsx scripts/send-test-email.ts",
    "storage:check": "tsx --conditions=react-server --env-file=.env scripts/check-storage.ts",
    "db:seed:prod": "tsx --env-file=.env.production.local prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
