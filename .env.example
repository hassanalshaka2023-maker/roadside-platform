# ==========================================================================
# Najdat Al-Tariq 24 - environment variables
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NEVER be committed.
# Every variable here is validated by zod at boot in src/lib/env.ts:
# a missing or malformed value fails fast with a clear message.
# ==========================================================================

# --- Core -----------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Public base URL of the app. Used for absolute links and for the CSRF
# Origin check. In production this MUST be the real https origin.
APP_URL=http://localhost:3000


# --- Database -------------------------------------------------------------

# PostgreSQL connection string.
# Local Windows install (PostgreSQL 18 on the default port):
#   postgresql://postgres:YOUR_PASSWORD@localhost:5432/roadside?schema=public
# Docker compose (service name `postgres`):
#   postgresql://roadside:roadside@postgres:5432/roadside?schema=public
#
# If your password contains special characters (@ : / ? # [ ] %),
# URL-encode them, e.g. `p@ss` -> `p%40ss`.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/roadside?schema=public


# --- Secrets --------------------------------------------------------------
# Generate each one separately with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Minimum 32 characters. NEVER reuse the same value for both.

# Reserved for signing/encrypting session-related values.
SESSION_SECRET=CHANGE_ME_generate_a_32_byte_random_string

# HMAC key used to hash OTP codes before they are stored.
# Rotating this invalidates every OTP currently in flight (that is fine).
OTP_HMAC_SECRET=CHANGE_ME_generate_a_different_32_byte_random_string


# --- SMS / OTP delivery ---------------------------------------------------

# console = print the OTP to the server log (DEVELOPMENT ONLY, refuses to
#           run when NODE_ENV=production)
# stub    = a placeholder for the real Syrian SMS gateway; every send throws
#           until the provider is wired up
SMS_PROVIDER=console

# OTP tuning. Defaults shown are the ones used when the variable is absent.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20


# --- Rate limiting --------------------------------------------------------

# memory   = in-process counters (development and tests only; they are lost
#            on restart and are not shared between instances)
# postgres = backed by the RateLimitEntry table (use this in production)
RATE_LIMIT_DRIVER=memory


# --- Auth / sessions ------------------------------------------------------

SESSION_TTL_CUSTOMER_DAYS=30
SESSION_TTL_ADMIN_HOURS=8

# Admin login lockout after too many failed attempts.
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15


# --- Seed accounts --------------------------------------------------------
# Used by `npm run db:seed`. The seed is idempotent, so changing the password
# here and re-running updates the existing account.
# CHANGE THESE BEFORE ANY REAL DEPLOYMENT.

SEED_ADMIN_EMAIL=admin@najdat24.sy
SEED_ADMIN_PASSWORD=ChangeMe_SuperAdmin_123

SEED_DISPATCHER_EMAIL=dispatcher@najdat24.sy
SEED_DISPATCHER_PASSWORD=ChangeMe_Dispatcher_123


# --- Logging --------------------------------------------------------------

# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug


# ==========================================================================
# PHASE 2 - private file storage
# ==========================================================================

# --- Storage driver -------------------------------------------------------

# local = files on disk (development)
# s3    = S3-compatible object storage (production)
STORAGE_DRIVER=local

# Absolute path for the local driver.
# MUST be OUTSIDE the project directory and must never sit under public/ -
# the driver refuses to start otherwise, because anything inside the project
# risks being served statically or swept into a git commit.
UPLOADS_DIR=C:\roadside-data\uploads

# Only read when STORAGE_DRIVER=s3.
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=roadside-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO and most non-AWS providers need path-style addressing.
S3_FORCE_PATH_STYLE=true


# --- File encryption ------------------------------------------------------
#
# Every file is encrypted by the application with AES-256-GCM BEFORE it
# reaches the storage backend, so the disk or the bucket operator never holds
# readable ID documents.
#
# Format: a versioned list, "<version>:<base64url 32-byte key>", comma
# separated. Generate a key with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ROTATION: add a NEW version and point FILE_ENCRYPTION_ACTIVE_VERSION at it.
# NEVER delete an old version while files encrypted with it still exist -
# every file records the version that encrypted it.
#
# *** LOSING THESE KEYS MEANS LOSING EVERY UPLOADED FILE, PERMANENTLY. ***
# There is no recovery path. Back them up separately from the database
# backup - see the "File encryption keys" section in README.md.
FILE_ENCRYPTION_KEYS=1:CHANGE_ME_generate_a_32_byte_base64url_key
FILE_ENCRYPTION_ACTIVE_VERSION=1

# HMAC key for hashing national ID numbers, so duplicates can be detected
# without ever storing the number itself. Must differ from the other secrets.
ID_HASH_SECRET=CHANGE_ME_generate_another_32_byte_random_string


# --- Upload limits --------------------------------------------------------

# Raw upload cap, enforced while streaming (not after buffering).
UPLOAD_MAX_BYTES=8388608
# Longest side of the stored image, in pixels.
UPLOAD_MAX_DIMENSION=2000
# Decompression-bomb guard: refuse to decode an image beyond this many pixels.
UPLOAD_MAX_PIXELS=50000000
# Per-user daily quota.
UPLOAD_MAX_FILES_PER_DAY=20
UPLOAD_MAX_BYTES_PER_DAY=67108864
# How long an unattached file survives before the cleanup job deletes it.
ORPHAN_FILE_TTL_HOURS=24


# ==========================================================================
# PHASE 3 - maps
# ==========================================================================
#
# Raster tile template for Leaflet. Read on the SERVER and passed to the map
# component as a prop, so it is validated by zod like everything else.
#
# The default below is the public OpenStreetMap server. It is fine while
# developing, but its usage policy FORBIDS production traffic and heavy use
# gets blocked. Before launch, point this at either:
#   - a keyed provider (MapTiler, Stadia, ...), or
#   - your own tile server on the VPS (a Syria extract is small)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

# Where the map opens before the customer's own location is known (Damascus).
MAP_DEFAULT_LAT=33.5138
MAP_DEFAULT_LNG=36.2765
MAP_DEFAULT_ZOOM=13
