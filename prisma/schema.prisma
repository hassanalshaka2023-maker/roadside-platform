// Najdat Al-Tariq 24 - database schema
//
// Conventions:
//   - uuid primary keys, so ids are safe to expose in URLs and logs
//   - every table carries createdAt/updatedAt
//   - indexes on foreign keys and on anything we filter or sort by
//   - soft deletes via deletedAt where data must survive for audit purposes
//   - MONEY IS AN INTEGER NUMBER OF SYRIAN POUNDS (columns end in `Syp`).
//     Never a float, never a Decimal that JavaScript turns into a float: a
//     price is a whole number of pounds and all arithmetic stays exact.
//
// Constraints Prisma cannot express live in hand-written SQL in the
// migrations:
//   1. Rating.stars -> CHECK (stars BETWEEN 1 AND 5)
//   2. ServiceRequest.publicCode / ProviderApplication.publicReference ->
//      Postgres SEQUENCEs, so codes are unique under concurrency
//   3. money CHECKs: amounts >= 0 and total = sum of its parts
//   4. partial unique indexes: one ACCEPTED offer per request, one PENDING
//      offer per provider per request
//   5. a trigger that refuses any change to the money of an ACCEPTED offer,
//      so an agreed price cannot be edited silently - not even by a bug

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here: the connection string for migrate
// lives in prisma.config.ts, and the runtime client gets a driver adapter.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum AdminLevel {
  SUPER_ADMIN
  DISPATCHER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum OtpPurpose {
  LOGIN
  APPLICATION
  REQUEST
}

enum FileKind {
  ID_FRONT
  ID_BACK
  SELFIE
  REQUEST_PHOTO
  EQUIPMENT_PHOTO
  /// Photos of a tow truck. Visible to admins, never to customers.
  VEHICLE_PHOTO
  /// Proof of ownership of, or authorisation to use, a tow truck. Treated
  /// with the same sensitivity as an ID document.
  VEHICLE_DOCUMENT
}

/// Whether an uploaded file has been linked to a real record yet.
///
/// An upload arrives before the form that owns it is submitted, so it starts
/// UNATTACHED. If the user abandons the form, nothing ever links it and the
/// cleanup job removes it.
enum FileLinkStatus {
  UNATTACHED
  ATTACHED
  DELETED
}

/// Approval state of a provider account.
///
/// Filling in the form is NOT verification: only an admin decision moves an
/// application to APPROVED, and only APPROVED creates a ProviderProfile that
/// can receive requests.
enum ApplicationStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  SUSPENDED
}

enum AvailabilityType {
  H24
  DAYTIME
  CUSTOM
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProviderKind {
  INDEPENDENT
  WORKSHOP
}

/// What kind of vehicle needs moving. Drives tow-truck capability matching.
enum VehicleCategory {
  SEDAN
  SUV
  PICKUP
  VAN
  MINIBUS
  LIGHT_TRUCK
}

/// The request lifecycle. Transitions are enforced by the state machine in
/// src/features/requests/state-machine.ts and every change is written to
/// RequestStatusHistory in the same transaction.
enum RequestStatus {
  /// Visible to eligible providers, collecting offers.
  SEARCHING
  /// The customer accepted an offer; the provider is booked.
  CONFIRMED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  /// The provider says the work is done and the cash is paid. Not final until
  /// the customer confirms: the provider's word alone proves nothing.
  AWAITING_CONFIRMATION
  COMPLETED
  /// The two sides disagree about completion or payment. An admin decides.
  DISPUTED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_PROVIDER
  CANCELLED_BY_ADMIN
  /// The search window closed without a single offer.
  NO_PROVIDER_AVAILABLE
  /// Offers came in, but the customer accepted none before the window closed.
  EXPIRED
}

enum PaymentMethod {
  CASH
}

enum OfferStatus {
  PENDING
  ACCEPTED
  /// Another offer on the same request was accepted.
  NOT_SELECTED
  WITHDRAWN
  EXPIRED
}

enum ExtraChargeStatus {
  PENDING
  APPROVED
  DECLINED
  WITHDRAWN
}

enum CommissionBase {
  /// Percentage of everything the customer paid.
  TOTAL
  /// Percentage of labour only (callout + labour, excluding parts).
  LABOR
}

enum CommissionEntryStatus {
  DUE
  SETTLED
  WAIVED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// One account per phone number. A tow-truck driver who also needs help for
/// his own car uses the same account - see docs/adr/001-identity-model.md.
model User {
  id               String      @id @default(uuid()) @db.Uuid
  role             Role        @default(CUSTOMER)
  /// Only set when role = ADMIN.
  adminLevel       AdminLevel?
  /// E.164, e.g. +963912345678. Null for admins, who log in by email.
  phone            String?     @unique
  /// Null for customers and providers, who log in by phone + OTP.
  email            String?     @unique
  /// argon2id. Admins only.
  passwordHash     String?
  name             String?
  isPhoneVerified  Boolean     @default(false)
  status           UserStatus  @default(ACTIVE)
  failedLoginCount Int         @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  sessions             Session[]
  customerProfile      CustomerProfile?
  providerProfile      ProviderProfile?
  providerApplication  ProviderApplication?   @relation("ApplicationApplicant")
  uploadedFiles        UploadedFile[]
  auditLogs            AuditLog[]             @relation("AuditActor")
  requestsAsCustomer   ServiceRequest[]       @relation("RequestCustomer")
  requestsAsProvider   ServiceRequest[]       @relation("RequestProvider")
  statusChanges        RequestStatusHistory[] @relation("StatusChangedBy")
  ratingsGiven         Rating[]               @relation("RatingCustomer")
  ratingsReceived      Rating[]               @relation("RatingProvider")
  reviewedApplications ProviderApplication[]  @relation("ApplicationReviewer")
  applicationDecisions ApplicationDecision[]
  settingsUpdated      Setting[]              @relation("SettingUpdater")
  offers               RequestOffer[]
  extraCharges         ExtraCharge[]
  invitesReceived      RequestInvite[]        @relation("InviteProvider")
  invitesSent          RequestInvite[]        @relation("InviteAdmin")
  commissionEntries    CommissionEntry[]
  settlements          CommissionSettlement[] @relation("SettlementProvider")
  settlementsRecorded  CommissionSettlement[] @relation("SettlementRecorder")
  complaintsFiled      Complaint[]            @relation("ComplaintFiler")
  complaintsResolved   Complaint[]            @relation("ComplaintResolver")

  @@index([role, status])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Database-backed sessions. Only the hash of the token is stored, so a stolen
/// database dump cannot be replayed as a login.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// sha256 of the random 32-byte token that lives in the cookie.
  tokenHash String    @unique
  userAgent String?
  /// Hashed, never the raw IP - see the logging rules in CLAUDE.md.
  ipHash    String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One row per issued OTP. The code itself is never stored: only an
/// HMAC-SHA256 of it, keyed by OTP_HMAC_SECRET.
model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  ipHash     String?

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

/// Backing store for the Postgres rate-limit driver. Deliberately not Redis:
/// one fewer service to run on the VPS, and our volumes are small.
model RateLimitEntry {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

model CustomerProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  city         String?
  idVerified   Boolean  @default(false)
  idDocumentId String?  @db.Uuid
  /// Hash of the ID number, for duplicate/fraud detection without storing
  /// the number itself.
  idHash       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  idDocument UploadedFile? @relation("CustomerIdDocument", fields: [idDocumentId], references: [id], onDelete: SetNull)

  @@index([city])
  @@index([idHash])
}

/// A provider's application, and after approval the record of how they were
/// vetted. One per account: a rejected or incomplete applicant edits and
/// resubmits the same row, so the decision history stays in one place.
model ProviderApplication {
  id                    String            @id @default(uuid()) @db.Uuid
  /// The applicant's account (phone verified by OTP before they can apply).
  userId                String            @unique @db.Uuid
  fullName              String
  phone                 String
  providerKind          ProviderKind      @default(INDEPENDENT)
  workshopName          String?
  workshopAddress       String?
  /// Role slugs from the flyer (auto-mechanic, tow-truck-driver, ...).
  specialties           String[]
  /// ServiceType slugs the applicant wants to offer.
  serviceTypes          String[]
  yearsOfExperience     Int?
  hasVehicleOrEquipment Boolean           @default(false)
  equipmentDescription  String?
  governorate           String
  coverageAreas         String[]
  /// Base location, used for distance matching once approved.
  baseLat               Float?
  baseLng               Float?
  availability          AvailabilityType  @default(CUSTOM)
  availabilityNotes     String?
  // --- tow trucks only ---------------------------------------------------
  towVehicleType        String?
  towVehiclePlate       String?
  towCapacities         VehicleCategory[]
  vehiclePhotoIds       String[]
  vehicleDocumentId     String?           @db.Uuid
  // --- identity (admin only) ---------------------------------------------
  idDocumentFrontId     String?           @db.Uuid
  idDocumentBackId      String?           @db.Uuid
  /// The personal photo. Treated as an identity document: admin only.
  selfieId              String?           @db.Uuid
  equipmentPhotoIds     String[]
  idHash                String?
  // --- consents ------------------------------------------------------------
  consentTerms          Boolean           @default(false)
  consentAccuracy       Boolean           @default(false)
  /// "I will not add any charge the customer has not approved."
  consentNoHiddenFees   Boolean           @default(false)
  consentAcceptedAt     DateTime?
  // --- review --------------------------------------------------------------
  status                ApplicationStatus @default(DRAFT)
  /// Shown to the applicant: why it was rejected or what is missing.
  decisionReason        String?
  /// Internal only, never shown to the applicant.
  adminNotes            String?
  reviewedByAdminId     String?           @db.Uuid
  submittedAt           DateTime?
  reviewedAt            DateTime?
  /// Short code the applicant can quote when following up, e.g. AP-000123.
  publicReference       String            @unique @default(dbgenerated("('AP-' || lpad(nextval('provider_application_ref_seq')::text, 6, '0'))"))
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user            User                  @relation("ApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByAdmin User?                 @relation("ApplicationReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  idDocumentFront UploadedFile?         @relation("ApplicationIdFront", fields: [idDocumentFrontId], references: [id], onDelete: SetNull)
  idDocumentBack  UploadedFile?         @relation("ApplicationIdBack", fields: [idDocumentBackId], references: [id], onDelete: SetNull)
  selfie          UploadedFile?         @relation("ApplicationSelfie", fields: [selfieId], references: [id], onDelete: SetNull)
  vehicleDocument UploadedFile?         @relation("ApplicationVehicleDocument", fields: [vehicleDocumentId], references: [id], onDelete: SetNull)
  providerProfile ProviderProfile?
  decisions       ApplicationDecision[]

  @@index([status, createdAt])
  @@index([phone])
  @@index([governorate])
  @@index([idHash])
  @@index([createdAt])
}

/// Append-only history of every review decision, with its reason.
model ApplicationDecision {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @db.Uuid
  adminId       String?           @db.Uuid
  fromStatus    ApplicationStatus
  toStatus      ApplicationStatus
  reason        String?
  createdAt     DateTime          @default(now())

  application ProviderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  admin       User?               @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

/// Created only when an application is APPROVED.
model ProviderProfile {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @unique @db.Uuid
  applicationId     String?           @unique @db.Uuid
  providerKind      ProviderKind      @default(INDEPENDENT)
  workshopName      String?
  /// ServiceType ids this provider is approved for. Changed by admins only.
  serviceTypeIds    String[]
  governorate       String?
  coverageAreas     String[]
  /// The provider's own limit. Matching uses min(this, admin search radius).
  serviceRadiusKm   Int               @default(25)
  towCapacities     VehicleCategory[]
  workingHours      String?
  /// Denormalised from Rating on every new rating, in the same transaction.
  ratingAverage     Float             @default(0)
  ratingCount       Int               @default(0)
  completedJobs     Int               @default(0)
  /// Manual toggle. There is no live GPS tracking, so currentLat/currentLng
  /// is the provider's base location.
  isAvailable       Boolean           @default(false)
  currentLat        Float?
  currentLng        Float?
  locationUpdatedAt DateTime?
  status            ProviderStatus    @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  application ProviderApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([status, isAvailable])
  @@index([isAvailable])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// There are NO prices here on purpose. The platform does not invent market
/// rates: every price comes from a provider's offer.
model ServiceType {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  /// Pricing rule shown next to offers, e.g. "the callout fee is due even if
  /// you decline the repair after inspection".
  pricingNoteAr String?
  pricingNoteEn String?
  /// True for towing: the request needs a destination and a vehicle category.
  requiresDestination Boolean @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requests ServiceRequest[]

  @@index([isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

model ServiceRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  /// Human-friendly code (RS-000123) from a Postgres sequence.
  ///
  /// SEQUENTIAL, therefore NEVER usable in a URL: RS-000042 would let anyone
  /// walk the whole table. It exists so a customer can quote it on the phone.
  publicCode         String           @unique @default(dbgenerated("('RS-' || lpad(nextval('service_request_public_code_seq')::text, 6, '0'))"))
  /// Unguessable secret for the shareable tracking link (/track/<token>).
  trackingToken      String           @unique
  /// Generated by the browser once per form. A retry after a dropped
  /// connection sends the same id, and gets the same request back instead of
  /// a duplicate.
  clientRequestId    String?          @db.Uuid
  customerId         String           @db.Uuid
  serviceTypeId      String           @db.Uuid
  status             RequestStatus    @default(SEARCHING)
  lat                Float
  lng                Float
  /// Shown to candidate providers instead of the exact location.
  governorate        String?
  addressText        String?
  /// Syrian addressing relies on landmarks more than street names.
  landmarkText       String?
  carMake            String?
  carModel           String?
  carYear            Int?
  plateNumber        String?
  carCategory        VehicleCategory?
  /// Towing: can the car roll, or are the wheels/steering locked?
  vehicleCanRoll     Boolean?
  problemDescription String?
  /// The customer chose "I don't know what's wrong".
  problemUnknown     Boolean          @default(false)
  photoIds           String[]
  // --- towing destination --------------------------------------------------
  destinationText    String?
  destinationLat     Float?
  destinationLng     Float?
  // --- search ------------------------------------------------------------
  /// Start of the current search round. Offers older than this belong to an
  /// earlier round.
  searchStartedAt    DateTime?
  searchExpiresAt    DateTime?
  searchAttempts     Int              @default(1)
  /// A towing request created from a failed repair search.
  fallbackFromId     String?          @db.Uuid
  // --- booking -----------------------------------------------------------
  assignedProviderId String?          @db.Uuid
  acceptedOfferId    String?          @unique @db.Uuid
  /// The customer explicitly accepted the callout/inspection fee terms as part
  /// of accepting the offer.
  feeTermsAcceptedAt DateTime?
  /// Expected arrival, updated by the provider.
  etaAt              DateTime?
  // --- completion and cash -------------------------------------------------
  paymentMethod      PaymentMethod    @default(CASH)
  /// Computed by the server: accepted offer + APPROVED extras. Never typed in.
  finalAmountSyp     Int?
  providerConfirmedAt DateTime?
  customerConfirmedAt DateTime?
  disputeReason      String?
  disputeResolution  String?
  // --- commission snapshot -------------------------------------------------
  /// Copied from the active policy when the offer is accepted, so changing
  /// the settings later never rewrites what old requests owe.
  commissionEnabled  Boolean          @default(false)
  commissionRateBps  Int              @default(0)
  commissionBase     CommissionBase?
  commissionSyp      Int              @default(0)
  cancelledReason    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  assignedAt         DateTime?
  completedAt        DateTime?

  customer         User                   @relation("RequestCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignedProvider User?                  @relation("RequestProvider", fields: [assignedProviderId], references: [id], onDelete: SetNull)
  serviceType      ServiceType            @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  acceptedOffer    RequestOffer?          @relation("AcceptedOffer", fields: [acceptedOfferId], references: [id], onDelete: Restrict)
  fallbackFrom     ServiceRequest?        @relation("Fallback", fields: [fallbackFromId], references: [id], onDelete: SetNull)
  fallbacks        ServiceRequest[]       @relation("Fallback")
  statusHistory    RequestStatusHistory[]
  offers           RequestOffer[]         @relation("RequestOffers")
  extraCharges     ExtraCharge[]
  invites          RequestInvite[]
  complaints       Complaint[]
  commissionEntry  CommissionEntry?
  rating           Rating?

  @@unique([customerId, clientRequestId])
  @@index([status, createdAt])
  @@index([status, searchExpiresAt])
  @@index([customerId, createdAt])
  @@index([assignedProviderId, status])
  @@index([serviceTypeId])
  @@index([createdAt])
}

/// A provider's priced offer for a request.
///
/// Once ACCEPTED its money columns are frozen by a database trigger: the
/// agreed price is a record, not a draft. The only change the trigger allows
/// is ACCEPTED -> WITHDRAWN, when the booked provider drops out and the
/// request goes back to searching.
model RequestOffer {
  id            String      @id @default(uuid()) @db.Uuid
  requestId     String      @db.Uuid
  providerId    String      @db.Uuid
  status        OfferStatus @default(PENDING)
  /// Callout and inspection fee.
  calloutFeeSyp Int
  laborSyp      Int
  partsSyp      Int
  /// Always calloutFeeSyp + laborSyp + partsSyp (CHECK constraint).
  totalSyp      Int
  etaMinutes    Int
  includesText  String?
  excludesText  String?
  /// When true, the callout fee is owed even if the customer declines the
  /// repair after the inspection. The customer sees and accepts this.
  calloutDueIfDeclined Boolean @default(true)
  validUntil    DateTime
  /// Sent in response to an admin's direct invitation.
  viaInvite     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  respondedAt   DateTime?

  request         ServiceRequest  @relation("RequestOffers", fields: [requestId], references: [id], onDelete: Cascade)
  provider        User            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  acceptedRequest ServiceRequest? @relation("AcceptedOffer")

  @@index([requestId, status])
  @@index([providerId, status])
  @@index([status, validUntil])
}

/// An additional cost discovered on site (parts, a bigger repair).
///
/// Kept apart from the request status so the main lifecycle stays simple.
/// Only APPROVED extras ever reach finalAmountSyp.
model ExtraCharge {
  id          String            @id @default(uuid()) @db.Uuid
  requestId   String            @db.Uuid
  providerId  String            @db.Uuid
  description String
  laborSyp    Int
  partsSyp    Int
  totalSyp    Int
  status      ExtraChargeStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  respondedAt DateTime?

  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider User           @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([requestId, status])
}

/// An admin pointing a request at a specific provider (the manual half of
/// hybrid dispatch). The provider still has to send an offer, and the customer
/// still has to accept it.
model RequestInvite {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @db.Uuid
  providerId  String   @db.Uuid
  invitedById String?  @db.Uuid
  createdAt   DateTime @default(now())

  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider  User           @relation("InviteProvider", fields: [providerId], references: [id], onDelete: Cascade)
  invitedBy User?          @relation("InviteAdmin", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([requestId, providerId])
  @@index([providerId, createdAt])
}

/// Append-only log of every status transition. This is the evidence trail for
/// disputes, so rows are never updated or deleted.
model RequestStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  requestId       String         @db.Uuid
  /// Null for the very first entry, when the request is created.
  fromStatus      RequestStatus?
  toStatus        RequestStatus
  changedByUserId String?        @db.Uuid
  note            String?
  createdAt       DateTime       @default(now())

  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy User?          @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([changedByUserId])
}

model Rating {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @unique @db.Uuid
  customerId String   @db.Uuid
  providerId String   @db.Uuid
  /// 1..5, enforced by a CHECK constraint added in the initial migration.
  stars      Int
  comment    String?
  createdAt  DateTime @default(now())

  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customer User           @relation("RatingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  provider User           @relation("RatingProvider", fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, createdAt])
  @@index([customerId])
}

model Complaint {
  id           String          @id @default(uuid()) @db.Uuid
  requestId    String          @db.Uuid
  filedById    String          @db.Uuid
  category     String
  description  String
  status       ComplaintStatus @default(OPEN)
  adminNote    String?
  resolvedById String?         @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filedBy    User           @relation("ComplaintFiler", fields: [filedById], references: [id], onDelete: Restrict)
  resolvedBy User?          @relation("ComplaintResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Commission (disabled and zero by default)
// ---------------------------------------------------------------------------

/// What a provider owes the platform for one completed request. Cash goes to
/// the provider, so commission is a debt recorded here, not a deduction.
/// Only created when the snapshotted amount is above zero.
model CommissionEntry {
  id            String                @id @default(uuid()) @db.Uuid
  requestId     String                @unique @db.Uuid
  providerId    String                @db.Uuid
  baseAmountSyp Int
  rateBps       Int
  amountSyp     Int
  status        CommissionEntryStatus @default(DUE)
  settlementId  String?               @db.Uuid
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  request    ServiceRequest        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  provider   User                  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  settlement CommissionSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([providerId, status])
}

/// A cash payment from a provider to the platform, settling commission.
model CommissionSettlement {
  id           String   @id @default(uuid()) @db.Uuid
  providerId   String   @db.Uuid
  amountSyp    Int
  note         String?
  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  provider   User              @relation("SettlementProvider", fields: [providerId], references: [id], onDelete: Restrict)
  recordedBy User?             @relation("SettlementRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  entries    CommissionEntry[]

  @@index([providerId, createdAt])
}

// ---------------------------------------------------------------------------
// Files, audit, settings
// ---------------------------------------------------------------------------

/// Metadata only. The bytes live in private storage (local disk in dev,
/// S3-compatible in prod), encrypted, with EXIF stripped and a random
/// storageKey. Nothing here is ever served from /public.
model UploadedFile {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String?   @db.Uuid
  kind       FileKind
  /// Random opaque key in the storage backend. Never the original filename.
  storageKey String    @unique
  /// The type we RE-ENCODED to, never what the client claimed.
  mimeType   String
  /// Size of the stored plaintext (after re-encoding), not of the upload.
  sizeBytes  Int
  /// sha256 of the stored plaintext, so a decrypted file can be verified.
  sha256     String
  encrypted  Boolean   @default(true)
  /// Which FILE_ENCRYPTION_KEYS version encrypted this file.
  keyVersion Int       @default(1)
  status     FileLinkStatus @default(UNATTACHED)
  /// When this file was linked to a real record. Null + older than
  /// ORPHAN_FILE_TTL_HOURS means the cleanup job may delete it.
  attachedAt DateTime?
  /// When the FileScanner last cleared this file.
  scannedAt  DateTime?
  createdAt  DateTime  @default(now())
  /// Set by deleteFile() and by the retention job; the stored bytes are
  /// destroyed at the same time.
  deletedAt  DateTime?

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  customerIdDocuments  CustomerProfile[]     @relation("CustomerIdDocument")
  applicationIdFronts  ProviderApplication[] @relation("ApplicationIdFront")
  applicationIdBacks   ProviderApplication[] @relation("ApplicationIdBack")
  applicationSelfies   ProviderApplication[] @relation("ApplicationSelfie")
  applicationVehicleDocs ProviderApplication[] @relation("ApplicationVehicleDocument")

  @@index([ownerId])
  @@index([kind])
  @@index([deletedAt])
  @@index([sha256])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([keyVersion])
}

/// Append-only. Every view of an ID document, every approval, every price or
/// commission-settings change lands here.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
}

/// Runtime configuration an admin can change without a deploy. Every key is
/// validated by the zod schemas in src/features/settings/platform.ts.
model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt

  updatedByUser User? @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
}
